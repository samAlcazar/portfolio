---
import { Image } from 'astro:assets';
import {
  ArrowRight,
  FileText,
  Mail,
  User,
  Terminal,
  Server,
  Database,
  Cpu,
  Layers,
  Code,
  Check
} from '@lucide/astro';
import profileImage from '../assets/profile.webp';
import IconGitHub from './IconGitHub.astro';
import { profile } from '../data/profile';
---

<section class="max-w-6xl mx-auto px-4 pt-8 pb-16 lg:py-20">
  <!-- Tarjeta Principal del Hero -->
  <div class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 sm:p-8 lg:p-10 border border-primary/10 shadow-2xl relative overflow-hidden">
    
    <!-- Acento decorativo sutil en el fondo -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-accent-2/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12 relative z-10">
      
      <!-- Foto de Perfil & Badge de Estado -->
      <div class="w-full lg:w-auto flex flex-col items-center flex-shrink-0">
        <div class="relative group">
          <div class="w-44 h-44 sm:w-52 sm:h-52 rounded-2xl overflow-hidden border-2 border-primary/15 shadow-[0_12px_36px_rgba(0,0,0,0.4)] group-hover:border-accent/50 transition-all duration-300">
            <Image
              src={profileImage}
              alt="Foto de perfil de Samuel Alejandro Alcázar"
              width={260}
              height={260}
              loading="eager"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <!-- Badge de Disponibilidad -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-neutral/90 border border-emerald-500/30 px-3 py-1 rounded-full shadow-lg flex items-center gap-1.5 whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[11px] font-medium text-emerald-400 font-mono">Disponible</span>
          </div>
        </div>
      </div>

      <!-- Contenido Textual & Propuesta de Valor -->
      <div class="flex-1 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-tertiary border border-primary/10 text-xs font-mono text-secondary mb-3">
          <Terminal size={13} class="text-accent" />
          <span>FullStack & Soluciones de Infraestructura</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-primary">
          {profile.name}
        </h1>

        <p class="text-lg sm:text-xl font-medium text-accent-2 mt-1.5">
          {profile.role} · Software, Servidores & Redes
        </p>

        <!-- Descripción Profesional Orientada a Soluciones Reales -->
        <p class="text-sm sm:text-base text-secondary mt-4 leading-relaxed max-w-2xl">
          Construyo soluciones tecnológicas completas: desde el diseño y aprovisionamiento de 
          <strong class="text-primary font-medium">servidores Linux y bases de datos</strong>, hasta la arquitectura de 
          <strong class="text-primary font-medium">APIs RESTful seguras</strong> e <strong class="text-primary font-medium">interfaces frontend de alto rendimiento</strong>.
          Mi enfoque une el desarrollo de software con la infraestructura para garantizar aplicaciones reales, rápidas y escalables.
        </p>

        <!-- CTAs Principales -->
        <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-3">
          <!-- CTA 1: Ver Proyectos -->
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-neutral rounded-xl font-medium text-sm hover:bg-white/90 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-md"
          >
            <span>Ver proyectos</span>
            <ArrowRight size={16} />
          </a>

          <!-- CTA 2: Descargar/Ver CV -->
          <a
            href="/cv"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-tertiary/80 text-primary border border-primary/15 rounded-xl font-medium text-sm hover:border-accent/40 hover:bg-tertiary transition-all"
          >
            <FileText size={16} class="text-accent" />
            <span>Ver CV</span>
          </a>

          <!-- CTA 3: GitHub -->
          <a
            href="https://github.com/samAlcazar"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-tertiary/80 text-secondary hover:text-primary border border-primary/15 rounded-xl text-sm font-medium hover:border-primary/30 transition-all"
            aria-label="Perfil de GitHub de Samuel Alcázar"
          >
            <IconGitHub size={16} />
            <span>GitHub</span>
          </a>

          <!-- CTA 4: Contacto -->
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-accent/20 text-accent border border-accent/30 rounded-xl text-sm font-medium hover:bg-accent/30 transition-all"
          >
            <Mail size={16} />
            <span>Contactarme</span>
          </a>
        </div>

        <!-- Enlace Secundario a Sobre mí -->
        <div class="mt-4 pt-4 border-t border-primary/10 flex items-center justify-center lg:justify-start gap-2 text-xs text-secondary">
          <span>¿Quieres conocer mi trayectoria en detalle?</span>
          <a href="/about" class="text-accent hover:underline inline-flex items-center gap-1 font-medium">
            <User size={13} />
            Sobre mí
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Pipeline Visual de Desarrollo Completo (Infraestructura -> Frontend -> Usuario) -->
  <div class="mt-8 bg-tertiary/30 rounded-2xl p-6 border border-primary/10">
    <div class="flex items-center justify-between gap-2 mb-4">
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-secondary/80 flex items-center gap-2">
        <Layers size={14} class="text-accent" />
        Capacidad de Entrega de Extremo a Extremo
      </h2>
      <span class="text-[11px] font-mono text-accent-2 hidden sm:inline-block">
        Ciclo Completo de Software
      </span>
    </div>

    <!-- Flujo de Arquitectura Horizontal -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      
      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-accent/40 transition-all">
        <Cpu size={20} class="text-accent mb-1.5" />
        <span class="font-semibold text-xs text-primary">1. Infraestructura</span>
        <span class="text-[11px] text-secondary mt-0.5">Linux · Servidores · Redes</span>
      </div>

      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-accent/40 transition-all">
        <Server size={20} class="text-accent mb-1.5" />
        <span class="font-semibold text-xs text-primary">2. Servidor</span>
        <span class="text-[11px] text-secondary mt-0.5">Nginx · Docker · VPS</span>
      </div>

      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-accent/40 transition-all">
        <Database size={20} class="text-accent mb-1.5" />
        <span class="font-semibold text-xs text-primary">3. Base de Datos</span>
        <span class="text-[11px] text-secondary mt-0.5">PostgreSQL · MongoDB</span>
      </div>

      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-accent-2/40 transition-all">
        <Terminal size={20} class="text-accent-2 mb-1.5" />
        <span class="font-semibold text-xs text-primary">4. Backend & API</span>
        <span class="text-[11px] text-secondary mt-0.5">Node.js · Express · REST</span>
      </div>

      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-accent-2/40 transition-all">
        <Code size={20} class="text-accent-2 mb-1.5" />
        <span class="font-semibold text-xs text-primary">5. Frontend</span>
        <span class="text-[11px] text-secondary mt-0.5">React · Next.js · Tailwind</span>
      </div>

      <div class="bg-neutral/80 border border-primary/10 rounded-xl p-3 flex flex-col items-center text-center group hover:border-emerald-500/40 transition-all">
        <Check size={20} class="text-emerald-400 mb-1.5" />
        <span class="font-semibold text-xs text-primary">6. Usuario Final</span>
        <span class="text-[11px] text-secondary mt-0.5">Solución en Producción</span>
      </div>

    </div>
  </div>
</section>
