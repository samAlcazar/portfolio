---
import { Calendar, Building2 } from '@lucide/astro';
import type { Experience } from '../data/experience';

export interface Props {
  experience: Experience;
  index: number;
  isLast: boolean;
}

const { experience, index, isLast } = Astro.props;
---

<div class="relative flex gap-6 opacity-0 animate-fade-in-up" style={`animation-delay: ${index * 80}ms;`}>

  <!-- Columna Izquierda: Línea de tiempo -->
  <div class="flex flex-col items-center flex-shrink-0">
    <!-- Dot indicador -->
    <div class="w-3 h-3 rounded-full bg-accent border-2 border-accent/50 mt-1.5 shadow-[0_0_8px_rgba(37,88,136,0.6)] flex-shrink-0 z-10"></div>
    <!-- Línea vertical que conecta con el siguiente item -->
    {!isLast && (
      <div class="w-px flex-1 mt-1 bg-gradient-to-b from-accent/30 to-transparent min-h-8"></div>
    )}
  </div>

  <!-- Columna Derecha: Contenido -->
  <div class="pb-8 flex-1">
    <div class="bg-tertiary/50 backdrop-blur rounded-xl p-5 border border-primary/10 hover:border-accent/30 transition-all duration-300 group">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
        <div>
          <h3 class="font-semibold text-base text-primary group-hover:text-accent transition-colors duration-200">
            {experience.role}
          </h3>
          <p class="text-sm text-accent-2 flex items-center gap-1.5 mt-0.5">
            <Building2 size={13} />
            {experience.company}
          </p>
        </div>
        <span class="text-xs text-secondary flex items-center gap-1.5 shrink-0 bg-tertiary/50 px-2.5 py-1 rounded-lg border border-primary/5 self-start">
          <Calendar size={12} />
          {experience.period}
        </span>
      </div>

      <p class="text-sm text-secondary mt-3 leading-relaxed">{experience.description}</p>

      {experience.techs && experience.techs.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {experience.techs.map((tech) => (
            <span class="px-2.5 py-0.5 bg-accent/10 text-accent border border-accent/20 rounded-lg text-xs">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

</div>

