---
import { Calendar, Building2, Award } from '@lucide/astro';
import type { Experience } from '../data/experience';

export interface Props {
  experience: Experience;
  index: number;
  isLast: boolean;
}

const { experience, index, isLast } = Astro.props;

const typeColors: Record<string, string> = {
  desarrollo: "bg-accent/15 text-accent border-accent/30",
  infraestructura: "bg-accent-2/15 text-accent-2 border-accent-2/30",
  gestion: "bg-amber-500/15 text-amber-400 border-amber-500/30",
  educacion: "bg-emerald-500/15 text-emerald-400 border-emerald-500/30"
};

const typeLabels: Record<string, string> = {
  desarrollo: "Desarrollo de Software",
  infraestructura: "Infraestructura & Operaciones",
  gestion: "Gestión & Análisis",
  educacion: "Educación & Formación"
};
---

<div class="relative flex gap-4 sm:gap-6 opacity-0 animate-fade-in-up" style={`animation-delay: ${index * 60}ms;`}>

  <!-- Columna Izquierda: Línea de tiempo & Indicador -->
  <div class="flex flex-col items-center flex-shrink-0">
    <!-- Dot indicador -->
    <div class="w-3.5 h-3.5 rounded-full bg-accent border-2 border-primary/20 mt-1.5 shadow-[0_0_10px_rgba(37,88,136,0.8)] flex-shrink-0 z-10"></div>
    <!-- Línea vertical -->
    {!isLast && (
      <div class="w-px flex-1 mt-2 bg-gradient-to-b from-accent/40 via-primary/10 to-transparent min-h-12"></div>
    )}
  </div>

  <!-- Columna Derecha: Tarjeta de Contenido -->
  <div class="pb-10 flex-1">
    <article class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 border border-primary/10 hover:border-accent/30 hover:shadow-lg transition-all duration-300 group">
      
      <!-- Encabezado: Cargo + Empresa + Periodo + Badge de Tipo -->
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2.5">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="font-bold text-lg text-primary group-hover:text-accent transition-colors">
              {experience.role}
            </h3>
            <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${typeColors[experience.type] || "bg-tertiary text-secondary border-primary/10"}`}>
              {typeLabels[experience.type] || experience.type}
            </span>
          </div>

          <p class="text-sm text-accent-2 font-medium flex items-center gap-1.5 mt-1">
            <Building2 size={14} />
            {experience.company}
          </p>
        </div>

        <span class="text-xs font-mono text-secondary flex items-center gap-1.5 shrink-0 bg-neutral/60 px-3 py-1.5 rounded-xl border border-primary/5 self-start">
          <Calendar size={13} />
          {experience.period}
        </span>
      </div>

      <!-- Descripción principal -->
      <p class="text-sm text-secondary mt-3 leading-relaxed">
        {experience.description}
      </p>

      <!-- Responsabilidades Clave -->
      {experience.responsibilities && experience.responsibilities.length > 0 && (
        <div class="mt-4 pt-3 border-t border-primary/5">
          <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-primary/70 mb-2">
            Responsabilidades clave
          </h4>
          <ul class="space-y-1.5 text-xs text-secondary/90 list-none p-0 m-0">
            {experience.responsibilities.map((resp) => (
              <li class="flex items-start gap-2">
                <span class="text-accent mt-0.5">•</span>
                <span>{resp}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Resultado / Impacto si existe -->
      {experience.results && (
        <div class="mt-3.5 p-3 rounded-xl bg-accent/5 border border-accent/15 text-xs text-secondary flex items-start gap-2">
          <Award size={15} class="text-accent shrink-0 mt-0.5" />
          <div>
            <strong class="text-primary font-medium">Impacto:</strong>{" "}
            <span>{experience.results}</span>
          </div>
        </div>
      )}

      <!-- Tecnologías utilizadas -->
      {experience.techs && experience.techs.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-primary/5">
          {experience.techs.map((tech) => (
            <span class="px-2.5 py-0.5 bg-tertiary/60 text-secondary border border-primary/5 rounded-lg text-xs font-mono">
              {tech}
            </span>
          ))}
        </div>
      )}

    </article>
  </div>

</div>
