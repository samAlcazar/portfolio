---
import { Calendar, Building2 } from '@lucide/astro';
import type { Experience } from '../data/experience';

export interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<div class="bg-tertiary/50 backdrop-blur rounded-xl p-6 border border-primary/10">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h3 class="font-semibold text-lg">{experience.role}</h3>
      <p class="text-sm text-accent flex items-center gap-1.5 mt-1">
        <Building2 size={14} />
        {experience.company}
      </p>
    </div>
    <span class="text-xs text-secondary flex items-center gap-1.5 shrink-0">
      <Calendar size={14} />
      {experience.period}
    </span>
  </div>
  <p class="text-sm text-secondary mt-3 leading-relaxed">{experience.description}</p>
  {experience.techs && experience.techs.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4">
      {experience.techs.map((tech) => (
        <span class="px-2.5 py-0.5 bg-tertiary/50 rounded-lg text-xs">{tech}</span>
      ))}
    </div>
  )}
</div>
