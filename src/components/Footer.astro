---
import { Mail, ArrowUpRight } from '@lucide/astro';
import IconGitHub from './IconGitHub.astro';
import IconLinkedIn from './IconLinkedIn.astro';

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/about", label: "Sobre mí" },
  { href: "/projects", label: "Proyectos" },
  { href: "/experience", label: "Experiencia" },
  { href: "/technologies", label: "Tecnologías" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contacto" },
  { href: "/cv", label: "CV" }
];
---

<footer class="border-t border-primary/10 bg-neutral/60 py-12 mt-20 transition-colors">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-primary/10">
      
      <!-- Columna 1: Identidad & Propuesta -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-lg bg-tertiary border border-primary/10 flex items-center justify-center font-mono font-bold text-xs text-accent">
            SA
          </span>
          <span class="font-bold tracking-tight text-base text-primary">
            Samuel Alejandro Alcázar
          </span>
        </div>
        <p class="text-sm text-secondary leading-relaxed max-w-md">
          Desarrollador FullStack enfocado en la construcción de soluciones tecnológicas integrales: desde servidores y bases de datos hasta APIs y aplicaciones web modernas.
        </p>
        <div class="text-xs text-secondary/70 font-mono flex items-center gap-2 pt-1">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Disponible para proyectos y oportunidades
        </div>
      </div>

      <!-- Columna 2: Navegación Rápida -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-primary/80 mb-3">
          Navegación
        </h4>
        <ul class="grid grid-cols-2 gap-y-2 gap-x-4 list-none p-0 m-0 text-sm">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-secondary hover:text-primary transition-colors text-xs inline-flex items-center gap-1"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Enlaces y Conectividad -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-primary/80 mb-3">
          Canales
        </h4>
        <ul class="space-y-2 list-none p-0 m-0 text-sm">
          <li>
            <a
              href="https://github.com/samAlcazar"
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary hover:text-primary transition-colors text-xs flex items-center gap-2 group"
            >
              <IconGitHub size={14} />
              <span>GitHub</span>
              <ArrowUpRight size={12} class="opacity-0 group-hover:opacity-100 transition-opacity ml-auto" />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/samuel-alcazar-83b6b366/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary hover:text-primary transition-colors text-xs flex items-center gap-2 group"
            >
              <IconLinkedIn size={14} />
              <span>LinkedIn</span>
              <ArrowUpRight size={12} class="opacity-0 group-hover:opacity-100 transition-opacity ml-auto" />
            </a>
          </li>
          <li>
            <a
              href="mailto:alcazar.samuel@gmail.com"
              class="text-secondary hover:text-primary transition-colors text-xs flex items-center gap-2 group"
            >
              <Mail size={14} />
              <span>alcazar.samuel@gmail.com</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright y Créditos -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-secondary">
      <p>
        &copy; {new Date().getFullYear()} Samuel Alejandro Alcázar. Todos los derechos reservados.
      </p>
      <p class="font-mono text-[11px] text-secondary/60">
        Construido con Astro & Tailwind CSS
      </p>
    </div>
  </div>
</footer>
