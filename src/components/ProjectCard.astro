---
import { ExternalLink, ArrowRight } from '@lucide/astro';
import IconGitHub from './IconGitHub.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColors: Record<string, string> = {
  "En producción": "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  "Completado": "bg-accent/10 text-accent border-accent/20",
  "Hackathon": "bg-amber-500/10 text-amber-400 border-amber-500/20",
  "En desarrollo": "bg-accent-2/10 text-accent-2 border-accent-2/20"
};
---

<article class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 border border-primary/10 hover:border-accent/40 hover:shadow-[0_4px_30px_rgba(37,88,136,0.15)] transition-all duration-300 flex flex-col h-full group">
  
  <!-- Header de la tarjeta: Título + Estado + Año -->
  <div class="flex items-start justify-between gap-3">
    <div>
      <span class="text-[11px] font-mono text-secondary uppercase tracking-wider">
        {project.category} · {project.year}
      </span>
      <h3 class="font-bold text-xl text-primary group-hover:text-accent transition-colors mt-0.5">
        <a href={`/projects/${project.id}`} class="hover:underline focus:outline-none">
          {project.title}
        </a>
      </h3>
    </div>

    <!-- Badge de Estado -->
    <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border shrink-0 ${statusColors[project.status] || "bg-tertiary text-secondary border-primary/10"}`}>
      {project.status}
    </span>
  </div>

  <!-- Descripción del proyecto -->
  <p class="text-sm text-secondary mt-3 leading-relaxed line-clamp-2">
    {project.shortDescription}
  </p>

  <!-- Problema & Solución en síntesis -->
  <div class="mt-4 p-3 rounded-xl bg-neutral/60 border border-primary/5 text-xs text-secondary/90 space-y-1.5 flex-1">
    <p>
      <strong class="text-primary font-medium">Problema:</strong>{" "}
      <span class="line-clamp-2">{project.problem}</span>
    </p>
  </div>

  <!-- Lista de Tecnologías -->
  <div class="flex flex-wrap gap-1.5 mt-4">
    {project.techs.map((tech) => (
      <span class="px-2.5 py-1 bg-tertiary/60 border border-primary/5 rounded-lg text-xs font-mono text-secondary">
        {tech}
      </span>
    ))}
  </div>

  <!-- Barra de Enlaces y Acciones -->
  <div class="flex items-center justify-between gap-2 mt-5 pt-4 border-t border-primary/10 text-xs">
    <!-- Enlace a detalle -->
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-1.5 text-accent font-medium hover:text-white transition-colors group/link"
      aria-label={`Ver caso de estudio detallado de ${project.title}`}
    >
      <span>Ver detalle</span>
      <ArrowRight size={14} class="group-hover/link:translate-x-0.5 transition-transform" />
    </a>

    <!-- Enlaces externos: GitHub & Demo -->
    <div class="flex items-center gap-2">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-secondary hover:text-primary hover:bg-tertiary/80 rounded-lg transition-colors border border-primary/5"
          aria-label={`Ver repositorio de código en GitHub para ${project.title}`}
          title="Ver código fuente"
        >
          <IconGitHub size={16} />
        </a>
      )}

      {project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 bg-tertiary/80 hover:bg-tertiary text-primary rounded-lg transition-colors border border-primary/10 font-medium"
          aria-label={`Visitar sitio en vivo de ${project.title}`}
          title="Visitar sitio en vivo"
        >
          <ExternalLink size={13} />
          <span>Demo</span>
        </a>
      )}
    </div>
  </div>

</article>
