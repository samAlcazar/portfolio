---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
import {
  ArrowRight,
  Code,
  Database,
  Cpu,
  ShieldCheck,
  Check,
  FileText,
  Mail
} from '@lucide/astro';

const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
---

<Layout
  title={`${profile.name} | ${profile.role}`}
  description={profile.tagline}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Sección: Proyectos Destacados -->
  <section class="max-w-6xl mx-auto px-4 py-12 lg:py-16 border-t border-primary/10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono text-accent uppercase tracking-wider mb-1">
          <Code size={14} />
          <span>Trabajo Real & Casos de Estudio</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary">
          Proyectos Destacados
        </h2>
        <p class="text-secondary text-sm mt-1 max-w-xl">
          Aplicaciones construidas para resolver necesidades reales, desde paneles editoriales y sistemas institucionales hasta herramientas de e-commerce e inteligencia artificial.
        </p>
      </div>

      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-white transition-colors group self-start md:self-auto"
      >
        <span>Ver todos los proyectos</span>
        <ArrowRight size={15} class="group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <!-- Rejilla de Proyectos Destacados -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Sección: Enfoque Integral (Infraestructura + Software) -->
  <section class="max-w-6xl mx-auto px-4 py-12 lg:py-16 border-t border-primary/10">
    <div class="bg-tertiary/30 backdrop-blur-md rounded-2xl p-8 lg:p-10 border border-primary/10">
      <div class="max-w-3xl">
        <span class="text-xs font-mono text-accent-2 uppercase tracking-wider">
          Propuesta de Valor
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary mt-1">
          ¿Por qué abordar el desarrollo desde la infraestructura hasta el frontend?
        </h2>
        <p class="text-secondary text-sm sm:text-base mt-3 leading-relaxed">
          Un buen producto de software no depende únicamente de librerías visuales. Requiere comprender cómo los datos viajan por la red, cómo el servidor gestiona la memoria, cómo la base de datos indexa las consultas y cómo el frontend ofrece una experiencia reactiva y accesible.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        
        <div class="p-5 rounded-xl bg-neutral/60 border border-primary/5 space-y-2">
          <div class="w-9 h-9 rounded-lg bg-accent/15 border border-accent/25 flex items-center justify-center text-accent">
            <Cpu size={18} />
          </div>
          <h3 class="font-semibold text-base text-primary">Sistemas & Servidores</h3>
          <p class="text-xs text-secondary leading-relaxed">
            Administración de entornos Linux, configuración de proxy reverso Nginx, seguridad en servidores y despliegues estables.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-neutral/60 border border-primary/5 space-y-2">
          <div class="w-9 h-9 rounded-lg bg-accent-2/15 border border-accent-2/25 flex items-center justify-center text-accent-2">
            <Database size={18} />
          </div>
          <h3 class="font-semibold text-base text-primary">Arquitectura & APIs</h3>
          <p class="text-xs text-secondary leading-relaxed">
            Modelado relacional con PostgreSQL, APIs REST en Node.js/Express, autenticación robusta y control de roles.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-neutral/60 border border-primary/5 space-y-2">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/15 border border-emerald-500/25 flex items-center justify-center text-emerald-400">
            <ShieldCheck size={18} />
          </div>
          <h3 class="font-semibold text-base text-primary">Experiencia & Rendimiento</h3>
          <p class="text-xs text-secondary leading-relaxed">
            Interfaces modernas con React, Next.js, Astro y Tailwind CSS, priorizando velocidad, accesibilidad y experiencia de usuario.
          </p>
        </div>

      </div>

      <div class="mt-8 pt-6 border-t border-primary/10 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-secondary">
          <Check size={15} class="text-emerald-400" />
          <span>Compromiso con código limpio, mantenible y orientado a producción.</span>
        </div>

        <a
          href="/about"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-tertiary text-primary text-xs font-medium border border-primary/15 hover:bg-tertiary/80 transition-colors"
        >
          <span>Conoce más sobre mi perfil técnico</span>
          <ArrowRight size={13} />
        </a>
      </div>
    </div>
  </section>

  <!-- Sección de Llamado a la Acción (CTA Final) -->
  <section class="max-w-6xl mx-auto px-4 py-12 lg:py-16">
    <div class="bg-gradient-to-br from-tertiary/60 to-neutral border border-primary/10 rounded-2xl p-8 sm:p-12 text-center relative overflow-hidden">
      <div class="max-w-xl mx-auto space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-primary">
          ¿Tienes un proyecto en mente o buscas un perfil técnico integral?
        </h2>
        <p class="text-secondary text-sm leading-relaxed">
          Estoy disponible para colaborar en el desarrollo de aplicaciones web completas, diseño de APIs o implementación de soluciones tecnológicas.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-neutral rounded-xl font-medium text-sm hover:bg-white/90 transition-all shadow-md"
          >
            <Mail size={16} />
            <span>Hablemos</span>
          </a>
          <a
            href="/cv"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-tertiary text-primary border border-primary/15 rounded-xl font-medium text-sm hover:bg-tertiary/80 transition-all"
          >
            <FileText size={16} class="text-accent" />
            <span>Ver Curriculum Vitae</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
