---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { experiences } from '../data/experience';
import { projects } from '../data/projects';
import {
  Printer,
  Mail,
  MapPin,
  FileText,
  Briefcase,
  Layers,
  ArrowLeft
} from '@lucide/astro';
import IconGitHub from '../components/IconGitHub.astro';
import IconLinkedIn from '../components/IconLinkedIn.astro';

const featuredProjects = projects.filter((p) => p.featured);
---

<Layout
  title={`Curriculum Vitae — ${profile.name}`}
  description={`Curriculum Vitae profesional de ${profile.name} — FullStack Developer con experiencia en desarrollo de software, servidores Linux y bases de datos.`}
>
  <section class="max-w-4xl mx-auto px-4 py-8 lg:py-16">
    
    <!-- Barra de Herramientas Superior (No se imprime) -->
    <div class="no-print flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-primary/10">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-secondary hover:text-primary transition-colors"
      >
        <ArrowLeft size={14} />
        <span>Volver al portafolio</span>
      </a>

      <div class="flex items-center gap-3">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-neutral rounded-xl text-xs font-medium hover:bg-white/90 transition-all cursor-pointer shadow-sm"
        >
          <Printer size={15} />
          <span>Imprimir / Guardar en PDF</span>
        </button>
      </div>
    </div>

    <!-- Hoja del CV -->
    <article class="print-page bg-tertiary/20 backdrop-blur-md rounded-2xl p-6 sm:p-10 border border-primary/10 space-y-8">
      
      <!-- Encabezado del CV -->
      <header class="pb-6 border-b border-primary/10">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold tracking-tight text-primary">
              {profile.name}
            </h1>
            <p class="text-base font-semibold text-accent mt-0.5">
              {profile.role} · Soluciones de Software & Infraestructura
            </p>
          </div>

          <div class="flex flex-col sm:items-end text-xs font-mono text-secondary space-y-1.5 shrink-0">
            <span class="flex items-center gap-1.5">
              <Mail size={13} class="text-accent" />
              <a href={`mailto:${profile.email}`} class="hover:underline">{profile.email}</a>
            </span>
            <span class="flex items-center gap-1.5">
              <IconGitHub size={13} />
              <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:underline">github.com/{profile.githubUsername}</a>
            </span>
            <span class="flex items-center gap-1.5">
              <IconLinkedIn size={13} />
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline">linkedin.com/in/{profile.linkedinUsername}</a>
            </span>
            <span class="flex items-center gap-1.5">
              <MapPin size={13} class="text-accent" />
              <span>{profile.location}</span>
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-secondary mt-4 leading-relaxed">
          {profile.summary}
        </p>
      </header>

      <!-- Habilidades Técnicas -->
      <section class="space-y-3">
        <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-accent flex items-center gap-2">
          <Layers size={16} />
          Habilidades & Stack Técnico
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-neutral/60 border border-primary/5 space-y-1">
            <strong class="text-primary font-medium">Desarrollo Web & APIs:</strong>
            <p class="text-secondary">{profile.skillsSummary.development.join(", ")}</p>
          </div>
          <div class="p-3 rounded-xl bg-neutral/60 border border-primary/5 space-y-1">
            <strong class="text-primary font-medium">Infraestructura & Servidores:</strong>
            <p class="text-secondary">{profile.skillsSummary.infrastructure.join(", ")}</p>
          </div>
          <div class="p-3 rounded-xl bg-neutral/60 border border-primary/5 space-y-1">
            <strong class="text-primary font-medium">Bases de Datos:</strong>
            <p class="text-secondary">{profile.skillsSummary.databases.join(", ")}</p>
          </div>
          <div class="p-3 rounded-xl bg-neutral/60 border border-primary/5 space-y-1">
            <strong class="text-primary font-medium">Herramientas & Flujo:</strong>
            <p class="text-secondary">{profile.skillsSummary.tools.join(", ")}</p>
          </div>
        </div>
      </section>

      <!-- Experiencia Laboral -->
      <section class="space-y-6">
        <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-accent flex items-center gap-2">
          <Briefcase size={16} />
          Experiencia Profesional
        </h2>

        <div class="space-y-6">
          {experiences.map((exp) => (
            <div class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div>
                  <h3 class="font-bold text-sm text-primary">{exp.role}</h3>
                  <p class="text-xs text-accent-2 font-medium">{exp.company}</p>
                </div>
                <span class="text-[11px] font-mono text-secondary self-start sm:self-auto">
                  {exp.period}
                </span>
              </div>
              <p class="text-xs text-secondary leading-relaxed">
                {exp.description}
              </p>
              {exp.responsibilities && exp.responsibilities.length > 0 && (
                <ul class="space-y-1 text-[11px] text-secondary/90 pl-3 list-disc">
                  {exp.responsibilities.map((resp) => (
                    <li>{resp}</li>
                  ))}
                </ul>
              )}
              {exp.techs && (
                <div class="flex flex-wrap gap-1 pt-1">
                  {exp.techs.map((t) => (
                    <span class="px-2 py-0.5 bg-neutral/80 border border-primary/5 rounded text-[10px] font-mono text-secondary">
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Proyectos Destacados -->
      <section class="space-y-4">
        <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-accent flex items-center gap-2">
          <FileText size={16} />
          Proyectos & Sistemas Destacados
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          {featuredProjects.map((proj) => (
            <div class="p-3.5 rounded-xl bg-neutral/60 border border-primary/5 space-y-1.5">
              <div class="flex items-center justify-between">
                <strong class="text-primary font-semibold">{proj.title}</strong>
                <span class="text-[10px] font-mono text-secondary">{proj.year}</span>
              </div>
              <p class="text-[11px] text-secondary line-clamp-2">{proj.shortDescription}</p>
              <div class="text-[10px] font-mono text-accent pt-1">
                {proj.techs.slice(0, 4).join(" · ")}
              </div>
            </div>
          ))}
        </div>
      </section>

    </article>

    <!-- Footer de la vista CV -->
    <div class="no-print mt-8 text-center text-xs text-secondary">
      <span>Curriculum Vitae actualizado de {profile.name} — {new Date().getFullYear()}</span>
    </div>

  </section>
</Layout>
