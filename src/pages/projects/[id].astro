---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';
import {
  ArrowLeft,
  ExternalLink,
  Layers,
  Cpu,
  Server,
  Terminal,
  Check,
  CircleAlert,
  Lightbulb,
  Tag
} from '@lucide/astro';
import IconGitHub from '../../components/IconGitHub.astro';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

export interface Props {
  project: Project;
}

const { project } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": project.title,
  "description": project.description,
  "applicationCategory": "WebApplication",
  "operatingSystem": "Web",
  "author": {
    "@type": "Person",
    "name": "Samuel Alejandro Alcázar"
  },
  "keywords": project.techs.join(", ")
};
---

<Layout
  title={`${project.title} — Caso de Estudio | Samuel Alejandro Alcázar`}
  description={project.shortDescription}
  structuredData={structuredData}
>
  <article class="max-w-4xl mx-auto px-4 py-12 lg:py-16">
    
    <!-- Botón Volver -->
    <div class="mb-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-secondary hover:text-primary transition-colors group"
      >
        <ArrowLeft size={14} class="group-hover:-translate-x-1 transition-transform" />
        <span>Volver a todos los proyectos</span>
      </a>
    </div>

    <!-- Encabezado del Proyecto -->
    <header class="space-y-4 pb-8 border-b border-primary/10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs font-mono px-3 py-1 rounded-md bg-tertiary border border-primary/10 text-accent">
          {project.category}
        </span>
        <span class="text-xs font-mono text-secondary">
          Año {project.year}
        </span>
        <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
          {project.status}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-primary">
        {project.title}
      </h1>

      <p class="text-base sm:text-lg text-secondary leading-relaxed max-w-3xl">
        {project.shortDescription}
      </p>

      <!-- Botones de Acción (Demo y GitHub) -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-tertiary hover:bg-tertiary/80 text-primary border border-primary/15 rounded-xl text-xs sm:text-sm font-medium transition-all"
          >
            <IconGitHub size={16} />
            <span>Ver código en GitHub</span>
          </a>
        )}

        {project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-neutral hover:bg-white/90 rounded-xl text-xs sm:text-sm font-medium transition-all shadow-sm"
          >
            <ExternalLink size={15} />
            <span>Visitar sitio en vivo</span>
          </a>
        )}
      </div>
    </header>

    <!-- Contenido Detallado del Caso de Estudio -->
    <div class="mt-10 space-y-12">
      
      <!-- 1. Resumen General -->
      <section class="space-y-3">
        <h2 class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
          <Layers size={20} class="text-accent" />
          Resumen del Proyecto
        </h2>
        <p class="text-sm sm:text-base text-secondary leading-relaxed">
          {project.description}
        </p>
      </section>

      <!-- 2. El Problema -->
      <section class="bg-tertiary/30 rounded-2xl p-6 border border-primary/10 space-y-3">
        <h2 class="text-lg font-bold tracking-tight text-primary flex items-center gap-2">
          <CircleAlert size={18} class="text-amber-400" />
          El Problema
        </h2>
        <p class="text-sm text-secondary leading-relaxed">
          {project.problem}
        </p>
      </section>

      <!-- 3. La Solución Técnica -->
      <section class="bg-tertiary/30 rounded-2xl p-6 border border-primary/10 space-y-3">
        <h2 class="text-lg font-bold tracking-tight text-primary flex items-center gap-2">
          <Lightbulb size={18} class="text-emerald-400" />
          Solución Técnica Implementada
        </h2>
        <p class="text-sm text-secondary leading-relaxed">
          {project.solution}
        </p>
      </section>

      <!-- 4. Diagrama de Arquitectura -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
          <Cpu size={20} class="text-accent-2" />
          Arquitectura del Sistema
        </h2>
        <p class="text-sm text-secondary">
          {project.architecture.summary}
        </p>

        <!-- Visual Flow Diagram -->
        <div class="bg-neutral/90 rounded-2xl p-6 border border-primary/10">
          <div class="flex flex-col md:flex-row items-center justify-between gap-3 text-xs font-mono">
            {project.architecture.flow.map((step, idx) => (
              <>
                <div class="w-full md:w-auto flex-1 bg-tertiary/60 border border-primary/10 rounded-xl p-3 text-center text-primary font-medium">
                  {step}
                </div>
                {idx < project.architecture.flow.length - 1 && (
                  <span class="text-accent hidden md:inline-block font-bold">➔</span>
                  <span class="text-accent md:hidden font-bold">↓</span>
                )}
              </>
            ))}
          </div>

          {project.architecture.serverInfo && (
            <div class="mt-4 pt-3 border-t border-primary/5 text-xs text-secondary/80 flex items-center gap-2 font-mono">
              <Server size={14} class="text-accent shrink-0" />
              <span>{project.architecture.serverInfo}</span>
            </div>
          )}
        </div>
      </section>

      <!-- 5. Funcionalidades Clave -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
          <Check size={20} class="text-emerald-400" />
          Funcionalidades Principales
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0 m-0">
          {project.features.map((feature) => (
            <li class="p-4 rounded-xl bg-tertiary/30 border border-primary/10 flex items-start gap-2.5 text-xs sm:text-sm text-secondary">
              <span class="text-emerald-400 font-bold mt-0.5">✓</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 6. Desafíos Técnicos y Soluciones -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
          <Terminal size={20} class="text-accent" />
          Desafíos Técnicos Superados
        </h2>
        <div class="space-y-3">
          {project.challenges.map((challenge) => (
            <div class="p-4 rounded-xl bg-neutral/60 border border-primary/5 text-xs sm:text-sm text-secondary flex items-start gap-3">
              <span class="text-accent font-bold mt-0.5">•</span>
              <span>{challenge}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 7. Tecnologías Utilizadas -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold tracking-tight text-primary flex items-center gap-2">
          <Tag size={20} class="text-accent-2" />
          Tecnologías Utilizadas
        </h2>
        <div class="flex flex-wrap gap-2">
          {project.techs.map((tech) => (
            <span class="px-3 py-1.5 bg-tertiary/70 border border-primary/15 rounded-xl text-xs font-mono text-primary">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- 8. Resultado & Conclusión -->
      <section class="p-6 rounded-2xl bg-accent/10 border border-accent/25 space-y-2">
        <h2 class="text-base font-semibold text-primary">
          Resultado e Impacto
        </h2>
        <p class="text-sm text-secondary leading-relaxed">
          {project.results}
        </p>
      </section>

    </div>

    <!-- Navegación al pie -->
    <div class="mt-14 pt-8 border-t border-primary/10 flex flex-wrap items-center justify-between gap-4">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-medium text-secondary hover:text-primary transition-colors"
      >
        <ArrowLeft size={14} />
        <span>Ver todos los proyectos</span>
      </a>

      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-neutral rounded-xl text-xs font-medium hover:bg-white/90 transition-all shadow-sm"
      >
        <span>¿Interesado en un desarrollo similar? Hablemos</span>
      </a>
    </div>

  </article>
</Layout>
