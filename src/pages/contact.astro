---
import Layout from '../layouts/Layout.astro';
import { Mail, Send, MapPin, MessageSquare, ArrowUpRight } from '@lucide/astro';
import IconGitHub from '../components/IconGitHub.astro';
import IconLinkedIn from '../components/IconLinkedIn.astro';
import { profile } from '../data/profile';
---

<Layout
  title="Contacto | Samuel Alejandro Alcázar"
  description="Ponte en contacto con Samuel Alejandro Alcázar para proyectos de desarrollo FullStack, consultoría técnica, infraestructura o soporte."
>
  <section class="max-w-5xl mx-auto px-4 py-12 lg:py-20">
    
    <!-- Encabezado -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-tertiary border border-primary/10 text-xs font-mono text-accent mb-2">
        <Mail size={13} />
        <span>Comunicación Directa</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-primary">
        Contacto
      </h1>
      <p class="text-secondary text-sm sm:text-base mt-2 leading-relaxed">
        ¿Tienes un proyecto en mente, necesitas apoyo técnico en desarrollo o infraestructura, o quieres charlar sobre tecnología? Envíame un mensaje o contáctame por mis redes profesionales.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-10">
      
      <!-- Columna Izquierda: Información Directa -->
      <div class="flex flex-col gap-4">
        
        <!-- Tarjeta Correo -->
        <a
          href={`mailto:${profile.email}`}
          class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 border border-primary/10 hover:border-accent/40 hover:shadow-lg transition-all duration-300 flex items-center gap-4 group"
        >
          <div class="p-3.5 bg-accent/15 border border-accent/25 rounded-xl text-accent group-hover:scale-105 transition-transform">
            <Mail size={22} />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-primary text-sm">Correo Electrónico</h3>
              <ArrowUpRight size={14} class="text-secondary opacity-0 group-hover:opacity-100 transition-opacity" />
            </div>
            <p class="text-xs sm:text-sm text-secondary truncate mt-0.5">{profile.email}</p>
          </div>
        </a>

        <!-- Tarjeta GitHub -->
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 border border-primary/10 hover:border-accent/40 hover:shadow-lg transition-all duration-300 flex items-center gap-4 group"
        >
          <div class="p-3.5 bg-tertiary border border-primary/10 rounded-xl text-primary group-hover:scale-105 transition-transform">
            <IconGitHub size={22} />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-primary text-sm">GitHub</h3>
              <ArrowUpRight size={14} class="text-secondary opacity-0 group-hover:opacity-100 transition-opacity" />
            </div>
            <p class="text-xs sm:text-sm text-secondary truncate mt-0.5">@{profile.githubUsername}</p>
          </div>
        </a>

        <!-- Tarjeta LinkedIn -->
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 border border-primary/10 hover:border-accent/40 hover:shadow-lg transition-all duration-300 flex items-center gap-4 group"
        >
          <div class="p-3.5 bg-accent-2/15 border border-accent-2/25 rounded-xl text-accent-2 group-hover:scale-105 transition-transform">
            <IconLinkedIn size={22} />
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-primary text-sm">LinkedIn</h3>
              <ArrowUpRight size={14} class="text-secondary opacity-0 group-hover:opacity-100 transition-opacity" />
            </div>
            <p class="text-xs sm:text-sm text-secondary truncate mt-0.5">/in/{profile.linkedinUsername}</p>
          </div>
        </a>

        <!-- Tarjeta de Ubicación / Disponibilidad -->
        <div class="p-5 rounded-2xl bg-neutral/80 border border-primary/5 text-xs text-secondary space-y-1">
          <div class="flex items-center gap-2 font-medium text-primary">
            <MapPin size={14} class="text-accent" />
            <span>Ubicación</span>
          </div>
          <p class="pl-5 text-secondary/80">Disponible para trabajo remoto y proyectos a nivel global.</p>
        </div>

      </div>

      <!-- Columna Derecha: Formulario de Contacto -->
      <div class="bg-tertiary/40 backdrop-blur-md rounded-2xl p-6 sm:p-8 border border-primary/10">
        <h2 class="text-lg font-bold text-primary mb-1 flex items-center gap-2">
          <MessageSquare size={18} class="text-accent" />
          Envíame un mensaje
        </h2>
        <p class="text-xs text-secondary mb-6">
          Responderé a la brevedad posible.
        </p>

        <form id="contact-form" class="space-y-4">
          <!-- Honeypot anti-spam -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="block text-xs font-mono font-medium text-primary/80 mb-1.5">
              Nombre o Empresa <span class="text-accent">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              minlength="2"
              maxlength="100"
              placeholder="Tu nombre o empresa"
              class="w-full bg-neutral/70 border border-primary/10 rounded-xl px-4 py-2.5 text-sm text-primary placeholder:text-secondary/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono font-medium text-primary/80 mb-1.5">
              Correo Electrónico <span class="text-accent">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@correo.com"
              class="w-full bg-neutral/70 border border-primary/10 rounded-xl px-4 py-2.5 text-sm text-primary placeholder:text-secondary/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono font-medium text-primary/80 mb-1.5">
              Mensaje o Detalles del Proyecto <span class="text-accent">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              minlength="10"
              maxlength="2000"
              placeholder="Describe en qué puedo ayudarte..."
              class="w-full bg-neutral/70 border border-primary/10 rounded-xl px-4 py-2.5 text-sm text-primary placeholder:text-secondary/50 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-button"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-primary text-neutral rounded-xl font-medium text-sm hover:bg-white/90 active:scale-[0.99] transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
          >
            <span>Enviar mensaje</span>
            <Send size={15} />
          </button>

          <!-- Contenedor para estados de éxito/error -->
          <div id="form-result" class="hidden text-xs p-3.5 rounded-xl text-center font-medium transition-all" role="status" aria-live="polite"></div>
        </form>
      </div>

    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const result = document.getElementById('form-result');
    const submitBtn = document.getElementById('submit-button') as HTMLButtonElement | null;

    if (form && result && submitBtn) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        const submitSpan = submitBtn.querySelector('span');
        if (submitSpan) {
          submitBtn.disabled = true;
          submitSpan.textContent = 'Enviando...';
        }

        const formData = new FormData(form);
        const name = (formData.get('name') as string || '').trim();
        const email = (formData.get('email') as string || '').trim();
        const message = (formData.get('message') as string || '').trim();

        // Validaciones en cliente
        if (!name || !email || !message) {
          result.className = 'text-xs p-3.5 rounded-xl text-center font-medium bg-red-500/10 text-red-400 border border-red-500/20';
          result.textContent = 'Por favor completa todos los campos requeridos.';
          result.classList.remove('hidden');
          if (submitSpan) {
            submitBtn.disabled = false;
            submitSpan.textContent = 'Enviar mensaje';
          }
          return;
        }

        // Opción directa: abrir cliente de correo nativo como fallback confiable o enviar vía webhook si está configurado
        const mailtoUrl = `mailto:alcazar.samuel@gmail.com?subject=${encodeURIComponent(`Contacto desde Portafolio - ${name}`)}&body=${encodeURIComponent(`Nombre: ${name}\nCorreo: ${email}\n\nMensaje:\n${message}`)}`;
        
        // Simular confirmación interactiva y ofrecer apertura directa
        setTimeout(() => {
          result.className = 'text-xs p-3.5 rounded-xl text-center font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
          result.innerHTML = '¡Gracias por tu mensaje! Abriendo cliente de correo para confirmación...';
          result.classList.remove('hidden');

          window.location.href = mailtoUrl;
          form.reset();

          if (submitSpan) {
            submitBtn.disabled = false;
            submitSpan.textContent = 'Enviar mensaje';
          }

          setTimeout(() => {
            result.classList.add('hidden');
          }, 8000);
        }, 400);
      });
    }
  });
</script>
